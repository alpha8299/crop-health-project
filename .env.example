# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=True

# Secret Key (Generate a secure key in production)
SECRET_KEY=your-secret-key-change-this-in-production

# Database
DATABASE_URL=sqlite:///crop_health.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@crophealth.com

# AWS S3 (Optional - for production image storage)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=crop-health-predictions

# Machine Learning Model
MODEL_PATH=models/crop_disease_model.h5

# Application Settings
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif
MAX_CONTENT_LENGTH=16777216

# Admin Email
ADMIN_EMAIL=admin@crophealth.com

# Pagination
ITEMS_PER_PAGE=10
